# Salin ke .env dan sesuaikan. Semua variabel berawalan SEBATIK_.
SEBATIK_ENVIRONMENT=development
SEBATIK_DATABASE_URL=sqlite:///data/processed/sebatik.db
# PostgreSQL (Fase 2 dan seterusnya):
# SEBATIK_DATABASE_URL=postgresql+psycopg://sebatik:sandi@localhost:5432/sebatik
SEBATIK_SECRET_KEY=GANTI-DENGAN-STRING-ACAK-MINIMAL-32-KARAKTER
SEBATIK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rotasi kunci: isi dengan kunci lama (dipisah koma) selama masa peralihan
# supaya token yang sudah terbit tidak ditolak serentak. Kosongkan lagi setelah
# TTL token lama lewat.
# SEBATIK_SECRET_KEYS=kunci-lama-satu,kunci-lama-dua
# Token akses berumur pendek; sesi disambung token segar di cookie httpOnly.
# SEBATIK_ACCESS_TOKEN_TTL_HOURS=2
# SEBATIK_REFRESH_TOKEN_TTL_HOURS=24
